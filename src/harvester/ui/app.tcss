/* OmniRip Modern Workstation TCSS Stylesheet */

Screen {
    background: $surface;
}

Header {
    height: 1;
    background: $panel;
    color: $text;
}

#statusbar {
    height: 1;
    padding: 0 1;
    color: $text;
    background: $panel;
    border-bottom: solid $primary;
}

#main {
    height: 1fr;
    width: 1fr;
}

#input-area {
    height: 4;
    padding: 0 1;
    margin: 1 1 0 1;
    border: round $primary;
    background: $panel;
}

#input-row {
    height: 3;
    width: 1fr;
    align: left middle;
}

#mode {
    width: 20;
    margin-right: 1;
}

#acquisition-policy {
    width: 24;
    margin-right: 1;
}

#mp3-quality {
    width: 14;
    margin-right: 1;
}

#source-input {
    width: 1fr;
    margin-right: 1;
}

#expand-playlists {
    margin-right: 1;
}

#submit {
    width: 10;
}

#btn-theme {
    width: 12;
    margin-left: 1;
}

#workspace-split {
    height: 1fr;
    width: 1fr;
    margin: 1 1 0 1;
}

#tracks-pane {
    width: 1fr;
    height: 1fr;
    margin-right: 1;
}

#workbench-pane {
    width: 52;
    height: 1fr;
}

#jobs {
    height: 2fr;
    min-height: 6;
    margin-bottom: 1;
    border: round $secondary;
    background: $panel;
}

#jobs > .datatable--cursor {
    background: $primary 30%;
    color: $text;
    text-style: bold;
}

#jobs > .datatable--header {
    background: $panel;
    color: $accent;
    text-style: bold;
}

#logs {
    height: 1fr;
    min-height: 4;
    border: round $surface-lighten-1;
    background: $surface;
}

#workbench-widget {
    height: 1fr;
    border: round $primary;
    background: $panel;
    padding: 0 1;
}

#audio-player {
    height: 8;
    min-height: 7;
    margin: 1 1 1 1;
    border: round $accent;
    background: $panel;
    padding: 0 1;
}

.modal-card {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: thick $primary;
    background: $panel;
}

.modal-card Button {
    width: 18;
    margin-top: 1;
    margin-right: 1;
}

.error-text {
    color: $error;
    text-style: bold;
}

.warning-text {
    color: $warning;
    text-style: bold;
}
