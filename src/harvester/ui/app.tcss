/* OmniRip Modern Workstation TCSS Stylesheet */

Screen {
    background: $surface;
}

Header {
    height: 1;
    background: $panel;
    color: $text;
}

#statusbar {
    height: 1;
    padding: 0 1;
    color: $text;
    background: $panel;
    border-bottom: solid $primary;
}

#main {
    height: 1fr;
    width: 1fr;
}

#input-area {
    height: 5;
    padding: 0 1;
    margin: 1 1 0 1;
    border: round $primary;
    background: $panel;
}

#input-row {
    height: 3;
    width: 1fr;
    align: left middle;
}

#mode {
    width: 20;
    margin-right: 1;
}

#acquisition-policy {
    width: 24;
    margin-right: 1;
}

#mp3-quality {
    width: 16;
    min-width: 16;
    margin-right: 1;
}

#source-input {
    width: 1fr;
    margin-right: 1;
}

#expand-playlists {
    margin-right: 1;
}

#submit {
    min-width: 14;
    width: auto;
    padding: 0 1;
}

#btn-theme {
    min-width: 12;
    width: auto;
    padding: 0 1;
    margin-left: 1;
}

#btn-soulseek {
    min-width: 14;
    width: auto;
    padding: 0 1;
    margin-left: 1;
}

Button {
    padding: 0 1;
}

Button:disabled {
    opacity: 60%;
    color: $text;
}

#app-nav-bar {
    height: 3;
    width: 1fr;
    margin: 0 1 0 1;
    align: left middle;
    background: $surface;
    border-bottom: heavy $secondary;
}

.app-nav-btn {
    min-width: 14;
    margin-right: 1;
    height: 3;
    border: none;
    background: transparent;
    color: $text-muted;
    text-style: bold;
}

.app-nav-btn:hover {
    color: $accent;
    background: $panel;
}

.app-nav-active {
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

#workspace-pages {
    height: 1fr;
    width: 1fr;
    margin: 1 1 0 1;
}

#tracks-pane {
    width: 1fr;
    height: 1fr;
}

#workbench-pane {
    width: 1fr;
    height: 1fr;
    display: none;
}

#jobs {
    height: 2fr;
    min-height: 6;
    margin-bottom: 1;
    border: round $secondary;
    background: $panel;
}

#jobs > .datatable--cursor {
    background: $primary 30%;
    color: $text;
    text-style: bold;
}

#jobs > .datatable--header {
    background: $panel;
    color: $accent;
    text-style: bold;
}

#logs {
    height: 1fr;
    min-height: 4;
    border: round $surface-lighten-1;
    background: $surface;
}

#workbench-widget {
    height: 1fr;
    border: round $primary;
    background: $panel;
    padding: 0 1;
}

#wb-stream-row {
    height: 3;
    align: left middle;
}

#wb-stream-row > Button {
    margin-right: 1;
    min-width: 9;
}

#audio-player {
    height: 10;
    min-height: 9;
    margin: 1 1 0 1;
    border: round $accent;
    background: $panel;
    padding: 0 1;
}

#player-wrapper {
    height: 1fr;
    width: 1fr;
}

#player-header-row {
    height: 1;
    width: 1fr;
    align: left middle;
}

#player-track-name {
    text-style: bold;
    color: $text;
    width: 1fr;
}

#player-stream-badge {
    width: auto;
    color: $accent;
    text-style: bold;
}

#player-timeline-row {
    height: 1;
    width: 1fr;
    align: left middle;
    margin-top: 0;
    margin-bottom: 0;
}

#player-time-cur {
    width: 7;
    color: $accent;
    text-style: bold;
    content-align: left middle;
}

#player-scrubber {
    height: 1;
    width: 1fr;
    margin: 0 1;
}

#player-time-total {
    width: 18;
    color: $text-muted;
    content-align: right middle;
}

#player-main-row {
    height: 1fr;
    width: 1fr;
    margin-top: 0;
}

#player-transport {
    height: 1fr;
    width: auto;
    align: left middle;
}

#player-transport Button {
    min-width: 6;
    width: auto;
    padding: 0 1;
    height: 3;
    margin-right: 1;
}

.btn-seek {
    min-width: 5;
}

#player-middle {
    width: 36;
    height: 1fr;
    padding: 0 1;
}

#player-visualizer {
    height: 1fr;
    width: 1fr;
}

#player-right {
    width: 1fr;
    height: 1fr;
    border-left: solid $primary 40%;
    padding-left: 1;
}

#player-monitor {
    height: 1fr;
    width: 1fr;
}

.modal-card {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: thick $primary;
    background: $panel;
}

.modal-card Button {
    width: 18;
    margin-top: 1;
    margin-right: 1;
}

.error-text {
    color: $error;
    text-style: bold;
}

.warning-text {
    color: $warning;
    text-style: bold;
}
