# Copy to .env and fill in. `.env` is gitignored; real shell exports always win.
# Override the file location with OMNIRIP_ENV_FILE=/path/to/file.

# AcoustID application key (free: https://acoustid.org/new-application)
# Used by harvester/services/acoustid.py for fingerprint lookups.
ACOUSTID_API_KEY=

# Local slskd daemon API key (optional; only needed for P2P sourcing).
SLSKD_API_KEY=

# MVSEP hosted separation API key (optional; https://mvsep.com → Profile → API).
# Used by the hosted separation engine: uploads an excerpt, polls the job, downloads stems.
# Verified against https://mvsep.com/api/app/user — free daily minutes, no key = no hosted runs.
MVSEP_API_KEY=

# Hugging Face token (optional; https://huggingface.co/settings/tokens).
# Needed for pyannote diarization (speaker/singer count) and other gated models.
# Also accept the terms for pyannote/speaker-diarization-community-1 to unlock the full pipeline.
HF_TOKEN=
