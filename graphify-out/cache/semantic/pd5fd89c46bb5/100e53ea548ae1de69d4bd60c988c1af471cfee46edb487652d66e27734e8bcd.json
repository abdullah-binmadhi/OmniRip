"captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_fr_17", "label": "FR-17 \u2014 Cancel & clean quit", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_nfr_1", "label": "NFR-1 \u2014 Strict async", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_nfr_2", "label": "NFR-2 \u2014 Bounded concurrency", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_nfr_3", "label": "NFR-3 \u2014 Resilience", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_nfr_4", "label": "NFR-4 \u2014 Graceful degradation", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_nfr_5", "label": "NFR-5 \u2014 Disk safety", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_nfr_6", "label": "NFR-6 \u2014 Secrets hygiene", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_nfr_7", "label": "NFR-7 \u2014 Portability", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_nfr_8", "label": "NFR-8 \u2014 Observability", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_d1", "label": "D1 \u2014 Single bitrate threshold (default 256)", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eliminates the 193-319 kbps gray zone from the brief; single threshold batch.skip_bitrate_kbps default 256, lossless always skipped."}, {"id": "docs_01_requirements_d2", "label": "D2 \u2014 Upcast honesty: provenance tags mandatory", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "320k CBR upcast adds no quality but mimics native 320 MP3; keep default per brief but mandate provenance tags (FR-12) and offer mp3-v0/keep-opus alternatives."}, {"id": "docs_01_requirements_d3", "label": "D3 \u2014 Spectral check scope: P2P lossless claims only", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spectral check only for P2P files claiming lossless; known-lossy exempt by provenance (FR-10) so the D2 upcast cannot trip the fraud check."}, {"id": "docs_01_requirements_d4", "label": "D4 \u2014 Keep original filename/path", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep original filename/path per brief; canonical renaming behind batch.rename_to_canonical flag (default off)."}, {"id": "docs_01_requirements_d5", "label": "D5 \u2014 .trash/ retention (7 days)", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "batch.trash_retention_days default 7; .trash/ is the rollback source of truth until purged."}, {"id": "docs_01_requirements_d6", "label": "D6 \u2014 slskd OpenAPI route verification", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "slskd REST routes vary across releases; verify against the daemon OpenAPI spec at startup and fail clearly on incompatible schemas."}, {"id": "docs_01_requirements_d7", "label": "D7 \u2014 ID3v2.3 / Vorbis comments", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ID3v2.3 for widest device/car-stereo compatibility; FLAC uses Vorbis comments + METADATA_BLOCK_PICTURE."}, {"id": "docs_01_requirements_d8", "label": "D8 \u2014 FFT in asyncio.to_thread", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "asyncio.to_thread first because numpy releases the GIL for most ops; escalate to ProcessPoolExecutor if UI frame drops are observed."}, {"id": "docs_01_requirements_d9", "label": "D9 \u2014 Fingerprint before transcode", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chromaprint matching degrades on transcoded files; fingerprint the downloaded source before transcoding, phase order 3 to 4 to 5 mandatory."}, {"id": "docs_01_requirements_d10", "label": "D10 \u2014 Playlist cap 50 + confirmation", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expand playlists with cap (default 50) + confirmation prompt; single-video URLs with playlist params treated as single tracks (--no-playlist semantics)."}, {"id": "docs_01_requirements_d11", "label": "D11 \u2014 Dedup skip by MBID", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1: skip when a file with the same canonical fingerprint (AcoustID recording MBID) already exists in the output directory; full dedup database is v2."}, {"id": "docs_01_requirements_d12", "label": "D12 \u2014 fallback_attempted anti-loop flag", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A job may use the fallback path at most once (fallback_attempted flag); after fallback it never re-enters HUNTING or SPECTRAL_CHECK."}, {"id": "docs_01_requirements_d13", "label": "D13 \u2014 Mode B fallback via ytsearch1 + swap temps", "file_type": "rationale", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch jobs lack input URLs so the fallback lane uses ytsearch1:<query>; swap temps named *.harvester.tmp.*, skipped by scans and purged at next scan start (AC-6)."}, {"id": "docs_01_requirements_ac_1", "label": "AC-1 \u2014 Launch < 3 s", "file_type": "concept", "source_file": "docs/01-requirements.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_01_requirements_ac_2", "label": "AC-2 \u2014 Mode A seeded FLAC end-to-end", "file_type": "concept", "source_fil