#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
LOCAL_CONFIG="$ROOT/tools/slskd/slskd.local.yml"
APP_CONFIG="$ROOT/config.toml"

case " ${*:-} " in
  *" --version "* | *" -v "* | *" --help "* | *" -h "*)
    exec uv run --project "$ROOT" python -m harvester "$@"
    ;;
  *" --no-slskd "* | *" --offline "*)
    exec uv run --project "$ROOT" python -m harvester "$@"
    ;;
esac

if [ ! -f "$LOCAL_CONFIG" ] || ! grep -q 'api_key:' "$LOCAL_CONFIG" 2>/dev/null || grep -q 'CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET' "$LOCAL_CONFIG" 2>/dev/null; then
  uv run --project "$ROOT" python -c "from harvester.services.slskd_config import save_slskd_credentials, read_slskd_credentials; creds = read_slskd_credentials(); save_slskd_credentials(creds.get('username', ''), creds.get('password', ''))" >/dev/null 2>&1 || true
fi

API_KEY=$(awk '/^[[:space:]]*api_key:/ {print $2; exit}' "$LOCAL_CONFIG" 2>/dev/null || true)
if [ -n "$API_KEY" ]; then
  export SLSKD_API_KEY="$API_KEY"
fi
export HARVESTER_CONFIG="$APP_CONFIG"

if [ -n "${SLSKD_API_KEY:-}" ] && ! curl -fsS -H "X-API-Key: $SLSKD_API_KEY" http://localhost:5030/api/v0/session >/dev/null 2>&1; then
  if [ -x "$ROOT/tools/slskd/slskd" ]; then
    printf '%s\n' "OmniRip: starting slskd on localhost:5030..."
    (cd "$ROOT/tools/slskd" && nohup ./slskd --config slskd.local.yml >"$ROOT/tools/slskd/slskd.log" 2>&1 &)
    ready=0
    i=0
    while [ "$i" -lt 15 ]; do
      i=$((i + 1))
      sleep 1
      if curl -fsS -H "X-API-Key: $SLSKD_API_KEY" http://localhost:5030/api/v0/session >/dev/null 2>&1; then
        ready=1
        break
      fi
    done
    if [ "$ready" -ne 1 ]; then
      printf '%s\n' "OmniRip: warning: slskd background daemon did not respond on localhost:5030" >&2
    fi
  fi
fi

exec uv run --project "$ROOT" python -m harvester "$@"
